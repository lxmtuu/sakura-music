# Create a private .env on the server; never commit or share it.
# The secret must be random, stable, and at least 32 bytes.
SECRET=
# Required only when initializing a new production database.
ADMIN_PASSWORD=
# Set only to the actual IPs/CIDRs of your trusted reverse proxies.
TRUSTED_PROXIES=
SAKURA_HOST_PORT=3000
SAKURA_DATA_DIR=./data
AUTO_BACKUP=1
BACKUP_INTERVAL_MINUTES=60
BACKUP_RETENTION=48
# Optional. Leave all empty to disable password reset email.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
